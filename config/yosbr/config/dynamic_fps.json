{
  "idle": {
    "timeout": 1800,
    "condition": "none"
  },
  "battery_tracker": {
    "notifications": false
  },
  "download_natives": false,
  "states": {
    "unfocused": {
      "frame_rate_target": 60,
      "show_toasts": true,
      "run_garbage_collector": true
    },
    "invisible": {
      "graphics_state": "reduced",
      "run_garbage_collector": true
    },
    "abandoned": {
      "frame_rate_target": -1,
      "enable_vsync": true,
      "show_toasts": false,
      "run_garbage_collector": true
    },
    "unplugged": {
      "enable_vsync": false
    },
    "hovered": {
      "run_garbage_collector": true
    }
  }
}
